# Normalize line endings: everything git detects as text becomes LF in the
# repository. Rust toolchain + shell scripts require LF.
* text=auto

*.rs   text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.md   text
*.yml  text
*.yaml text
*.json text
*.xml  text

# Binary assets
*.png  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.asc  text

# ── Linguist: honest language stats ──────────────────────────────────────────
# Vendored, never authored here. The specification text is the oracle, the three
# bundles beside it are the released machine-readable artifacts, and every one
# of them is refreshed by its `scripts/vendor/*.sh` script rather than edited.
specs/**  linguist-vendored

# The catalogue is machine-readable DATA, not source. It is hand-authored and
# reviewed line by line, but counting 1100 case cores as YAML source would make
# the language bar describe the catalogue's size rather than the instrument's.
artifacts/**  linguist-generated=true
# The emitted JSON Schemas: regenerated by `veredictum emit-schemas` and
# drift-tested, so a hand edit is a defect.
schemas/**    linguist-generated=true

# Only the instrument's own code counts toward the language bar: the guard and
# vendoring scripts, the hooks and the agent configuration are support material.
scripts/**   linguist-detectable=false
.githooks/** linguist-detectable=false
.claude/**   linguist-detectable=false

# Vendored upstream corpora are byte-verbatim (the vendored-corpora rule):
# no EOL normalization — upstream CKM exports carry CRLF and must round-trip
# bit-identical through clone/checkout.
artifacts/corpus/archetypes/** -text
artifacts/corpus/templates/ckm/full/** -text

# The brand palette and the seal are design assets, not source: without this the
# language bar gives a CSS file the same weight as the runner.
assets/** linguist-documentation
