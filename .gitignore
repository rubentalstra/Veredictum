# ── Rust build output ───────────────────────────────────────────────────────
debug
/target
# Defensive: a *relative* CARGO_TARGET_DIR (an IDE env misconfiguration) creates
# per-crate nested target directories. Never let them reach the tree.
**/target/
**/*.rs.bk
*.pdb
*.rlib

# Cargo.lock is deliberately NOT listed here. This repository ships a binary, so
# the lock file is committed: it is what makes every `--locked` gate in CI fail
# on a new commit rather than on registry drift
# (https://doc.rust-lang.org/cargo/faq.html#why-have-cargolock-in-version-control),
# and it is what OpenSSF Scorecard's Pinned-Dependencies check reads.

# Generated by cargo mutants: mutation-testing data.
**/mutants.out*/

# ── Fuzzing ─────────────────────────────────────────────────────────────────
# `fuzz/seeds/` is generated by `fuzz/seeds.sh` from material already in the
# tree; `fuzz/corpus/` is what libFuzzer grows and the CI cache carries between
# runs; `fuzz/artifacts/` and `fuzz/coverage/` are a run's scratch output.
# `fuzz/regressions/` is deliberately absent from this list: it is the TRACKED
# half, the recorded inputs of past findings, re-checked by every run forever.
/fuzz/seeds/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# insta pending snapshots — never committed.
**/*.snap.new

# Coverage and bench artifacts.
/coverage
lcov.info
*.profraw

# sccache
.sccache/

# cargo-cyclonedx output. An SBOM is generated per release and attached to it as
# an attested asset, never committed: a checked-in SBOM describes whatever graph
# happened to be resolved the day someone ran it.
*.cdx.json

# ── Secrets ─────────────────────────────────────────────────────────────────
# A party's IXIT declaration carries the endpoint and the credentials a run
# authenticates with, and the SMART lane carries a signing key. Those are the
# operator's secrets, and SECURITY.md treats leaking them as a vulnerability in
# this instrument. This is the belt: they are one `git add -A` away from a
# history where removing them means rewriting it.
.env
.env.*
!.env.example
*.pem
*.key
ixit.local.json
**/ixit.local.json

# ── Editor and OS ───────────────────────────────────────────────────────────
# `.idea/` is deliberately TRACKED here (the shared JetBrains project files, per
# the JetBrains template); its own `.idea/.gitignore` excludes the per-user
# files. Do not add `.idea/` to this list.
.vscode/*
!.vscode/extensions.json
.DS_Store

# ── Claude Code local state ─────────────────────────────────────────────────
# Session state written by the SessionStart hook, and local settings overrides.
CLAUDE.local.md
.claude/settings.local.json
.claude/.session-start-head
.claude/.session-start-time

# ── Documentation site build output ─────────────────────────────────────────
# `scripts/site/build.sh` assembles the deployable tree here; the Docs workflow
# rebuilds it from `website/` on every run, so nothing under it is committed.
/_site/
/website/book/book/
