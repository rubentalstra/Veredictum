# SPDX-License-Identifier: Apache-2.0
#
# The Vercel container build for the hosted console (#348,
# console.veredictum.eu) — the name Dockerfile.vercel is Vercel's fixed
# convention for its Container preset: the entrypoint accepts only the names
# Dockerfile/Containerfile with the .vercel suffix, resolved against the
# service's `root` (https://vercel.com/docs/functions/container-images
# §Services — the FerroEHR#2945 lesson). Veredictum deploys ONE service, so
# it roots at the repository top and this file lives here, where COPY reaches
# the catalogue and the vendored specification oracle.
#
# FROM the PUBLISHED release image, so the hosted console runs the exact
# release bytes and Vercel's build is a pull plus data layers. `:latest` is
# the release pointer scan-and-tag moves on a real release tag only (never a
# pre-release), and the ONLY deploy trigger is
# .github/workflows/sandbox-deploy.yml, which a release pings AFTER that leg
# succeeds — so this reference always resolves and no cut-time bump exists.
#
# The hosted instance is FULLY WORKING. The base image carries the engine at
# /usr/local/bin/veredictum beside the console (#375) and this overlay leaves
# VEREDICTUM_ENGINE inherited, so a visitor connects their own reachable CDR
# and drives a real run over the baked catalogue, party statements and
# specification oracle. A run's output lands on the container's ephemeral
# filesystem and vanishes on the next deploy, which is what a sandbox is.

# The base runs as uid 65532 and the /work tree COPYed below is root-owned, so
# the output directory has to arrive already owned by that uid. distroless
# carries no shell, so no RUN can make it there: this stage has one.
FROM busybox@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0 AS mkdirs
RUN mkdir -p /empty/out

FROM ghcr.io/rubentalstra/veredictum:latest

# The base image already runs as uid 65532 (distroless nonroot); stated
# explicitly so the posture is a property of THIS file too (trivy DS-0002).
USER 65532:65532

# The compose stack mounts the repository at /work; the hosted instance has
# no volume, so the same paths are baked from the checkout Vercel builds.
COPY artifacts/ /work/artifacts/
COPY specs/openehr/ /work/specs/openehr/
COPY party/ /work/party/

# The runs directory, owned by the console's own uid so a run can create its
# job directory. It arrives from the helper stage above and starts empty, the
# same state a fresh local mount starts from.
COPY --from=mkdirs --chown=65532:65532 /empty/ /work/

# ROOT and SPECS are already /work-anchored in the base image; PARTY and OUT
# default to paths relative to /app there, so both are pinned here.
ENV VEREDICTUM_PARTY=/work/party \
    VEREDICTUM_OUT=/work/out

# Vercel forwards to $PORT and its default is 80 — an image-level PORT does
# not change what the platform expects (FerroEHR#2947 measured it live:
# "could not connect to $PORT=80 … detected ports your server listened on:
# 3000", the exact init-timeout this instance hit too). The console reads its
# bind address from LEPTOS_SITE_ADDR at startup, so it is rebound to 80 here.
ENV LEPTOS_SITE_ADDR=0.0.0.0:80
ENV PORT=80
