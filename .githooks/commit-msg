#!/usr/bin/env bash
# SPDX-FileCopyrightText: Veredictum contributors
# SPDX-License-Identifier: Apache-2.0
# .githooks/commit-msg  (installed by scripts/install-hooks.sh)
#
# Ported from FerroEHR at the Veredictum split (FerroEHR#2789); logic unchanged.
# Mechanically strips AI or tool attribution from a commit message before the
# commit is recorded, so the CLAUDE.md rule holds even when a message is written
# outside an agent session. Runs on every commit, including --amend, squash and
# merge.
#
# Exit code is always 0: the message is rewritten in place, and a commit is never
# blocked just for having contained attribution.

set -euo pipefail

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

# Patterns removed, matched case-insensitively on a whole line. Deliberately
# broad, to catch trailers, footers, emoji lines and variants.
strip_patterns=(
  '^[[:space:]]*Co-authored-by:.*[Cc]laude'
  '^[[:space:]]*Co-authored-by:.*[Aa]nthropic'
  '^[[:space:]]*Co-authored-by:.*noreply@anthropic\.com'
  '^[[:space:]]*Co-authored-by:.*\[bot\]'
  '[Gg]enerated[[:space:]]+with[[:space:]]+.*[Cc]laude'
  '[Gg]enerated[[:space:]]+by[[:space:]]+.*[Cc]laude'
  '[Cc]laude[[:space:]]+[Cc]ode'
  '🤖'
  '^[[:space:]]*Assisted-by:.*[Cc]laude'
  '^[[:space:]]*Signed-off-by:.*[Cc]laude'
  'Anthropic[[:space:]]+Claude'
)

tmp="$(mktemp)"
cp "$MSG_FILE" "$tmp"

for pat in "${strip_patterns[@]}"; do
  grep -viE "$pat" "$tmp" > "$tmp.next" || true
  mv "$tmp.next" "$tmp"
done

# Collapse runs of blank lines into one, so removing a footer block does not
# leave a gap.
awk 'BEGIN{blank=0}
     /^[[:space:]]*$/{blank++; if(blank<=1) print ""; next}
     {blank=0; print}' "$tmp" > "$tmp.clean"

# Trim trailing blank lines.
sed -e :a -e '/^\n*$/{$d;N;ba}' "$tmp.clean" > "$MSG_FILE" 2>/dev/null || cp "$tmp.clean" "$MSG_FILE"

rm -f "$tmp" "$tmp.clean" "$tmp.next" 2>/dev/null || true
exit 0
