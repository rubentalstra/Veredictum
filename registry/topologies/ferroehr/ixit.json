{
  "instances": {
    "sut": {
      "base_url": "http://127.0.0.1:8080/ferroehr/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_USER",
        "password_env": "SUT_PASS"
      }
    },
    "unauthenticated": {
      "base_url": "http://127.0.0.1:8080/ferroehr/rest/openehr/v1",
      "auth": {
        "mode": "none"
      }
    }
  },
  "signing": {
    "mode": "digest",
    "algorithm": "sha256",
    "encoding": "base64",
    "prefix": "sha256:"
  }
}
