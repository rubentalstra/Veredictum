{
  "instances": {
    "sut": {
      "base_url": "http://127.0.0.1:8090/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_USER",
        "password_env": "SUT_PASS"
      }
    },
    "unauthenticated": {
      "base_url": "http://127.0.0.1:8090/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "none"
      }
    }
  },
  "containers": {
    "sut": "veredictum-reproduce-ehrbase-ehrbase-1",
    "db": "veredictum-reproduce-ehrbase-ehrdb-1"
  }
}
