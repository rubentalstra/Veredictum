# TLS for console.veredictum.eu, which Caddy obtains and renews on its own.
#
# Nothing in CI touches a certificate, and nothing expires quietly at 3am. This
# is the one piece that is strictly worse when hand-rolled.
#
# The file reaches the box from inside the image (#423): it is COPYed to
# /app/posture/ and installed by the deploy script, which then restarts the caddy
# service — a bind-mounted file's contents changing does not recreate the
# container that mounts it, so without that restart an edit here serves nothing.

console.veredictum.eu {
	reverse_proxy console:3000

	encode zstd gzip

	# The console reads the client address from X-Forwarded-For, and ONLY because
	# `VEREDICTUM_CLIENT_IP_HEADER` names it. Caddy sets it; nothing else can,
	# because Caddy is the only thing on the public port.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The hydration bundle is served under unhashed names, and wasm-bindgen import
	# symbols carry a per-build hash, so a browser holding the previous release's
	# veredictum-console.js and fetching the new .wasm pairs two builds and fails
	# to instantiate: "LinkError: import function ... must be callable" (#450,
	# seen live after the v0.1.4 deploy). `no-cache` permits caching and REQUIRES
	# revalidation (https://www.rfc-editor.org/rfc/rfc9111#section-5.2.2.4), which
	# with the ETag Caddy already sends costs a 304 and makes that pair
	# impossible. Content-hashed names would allow `immutable` instead; #450
	# carries that adjudication.
	@bundle path /pkg/*
	header @bundle Cache-Control "no-cache"

	# A conformance run streams its progress for minutes and the live screen
	# polls once a second, so the defaults are raised for the run surfaces
	# rather than for everything.
	@run path /run/* /api/*
	handle @run {
		reverse_proxy console:3000 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	log {
		output stdout
		format console
	}
}
