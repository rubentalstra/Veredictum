# /opt/veredictum-console/.env — readable by the service user alone.
#
# Copy to `.env` on the box. Nothing here is committed with a real value, and
# the one credential is not a signing key: see registry/keys/README.md for why
# the registry key never comes near this host.

# How many runs this host drives at once, and the one value to change when the
# box is resized — with the memory limit in docker-compose.yml, which moves for
# the same reason. Two is what #388 reasoned for an 8 GB machine, which the
# CX33 is (#523); it stays a starting value until a measured run on this host
# confirms it. docker-compose.yml substitutes
# `${VEREDICTUM_MAX_CONCURRENT_RUNS:-1}`, so an unset value arrives as one.
# A value that is not a positive integer refuses to start rather than falling
# back to something larger.
VEREDICTUM_MAX_CONCURRENT_RUNS=2

# The exact image reference the compose file runs. ONE image (#420): it carries
# the engine, the console and the release's own catalogue and oracle,
# which is why this instance mounts nothing. `:latest` is the
# release pointer `scan-and-tag` moves on a real release tag, and naming a
# version here instead is how a rollback pins an older one.
CONSOLE_IMAGE=ghcr.io/rubentalstra/veredictum:latest

# The console's GitHub App, which opens a submission's pull request (#391).
# It cannot sign a record. Unset, the submit section explains what to configure
# and offers no button, which is a first-class state rather than an error.
VEREDICTUM_GITHUB_APP_ID=
VEREDICTUM_GITHUB_APP_KEY=/run/secrets/github-app.pem
VEREDICTUM_GITHUB_INSTALLATION_ID=
VEREDICTUM_REGISTRY_REPO=rubentalstra/Veredictum
